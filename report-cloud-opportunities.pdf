   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Planet Earth with detailed relief is covered with a complex luminous network of air routes based on real data. Pacific Ocean. Japan, China. 3D rendering. Elements of this image furnished by NASA</rdf:li>
    </rdf:Alt>
   </dc:description>
